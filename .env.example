# Copy to .env only if you want to override defaults. No secrets are required;
# every value below is an ordinary configuration default. docker compose reads
# this file automatically, and shell environment variables take precedence.

# --- API service ---------------------------------------------------------
# Model dependency boundary (the mock by default).
MOCK_URL=http://mock:8001
# SQLite DLQ path *inside the container*. The host directory is mounted at /data.
DATABASE_PATH=/data/dlq.sqlite3
# TOTAL attempts per logical event (initial attempt + retries).
MAX_ATTEMPTS=3
BASE_DELAY_SECONDS=0.2
MAX_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=3
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_SECONDS=10

# Host directory bind-mounted into the api container at /data for the SQLite DLQ.
# Defaults to ./data next to docker-compose.yml. Read by docker compose, not the app.
DLQ_HOST_DIR=./data

# Test-only failure simulation for the /ui dashboard. Keep false outside local
# development. Set to true for both the api and mock services to enable the
# deterministic failure-scenario controls.
ENABLE_TEST_CONTROLS=false

# --- Dead-letter queue backend (optional; ECS sets this in Terraform) -------
# "sqlite" (default) stores dead letters in DATABASE_PATH; one file per task.
# "dynamodb" uses the shared DLQ_TABLE_NAME so records survive task replacement
# and are visible to every task behind the load balancer. Terraform sets
# DLQ_BACKEND=dynamodb + DLQ_TABLE_NAME for the ECS API task.
DLQ_BACKEND=sqlite
DLQ_TABLE_NAME=

# --- CloudWatch custom metrics (optional; ECS sets these in Terraform) -----
# Disabled by default, so local runs and tests never call AWS. When enabled the
# API publishes InFlightRequestsPerTask / ApiRequests / ApiLatencyMs and needs
# AWS credentials plus cloudwatch:PutMetricData for this namespace.
# Enabling requires BOTH ECS_CLUSTER_NAME and ECS_SERVICE_NAME below: they are
# the dimensions the target-tracking policy and dashboard query, so the API
# refuses to start if either is empty (it must not emit an unusable gauge).
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRIC_NAMESPACE=CollectionsChallenge
CLOUDWATCH_METRICS_INTERVAL=10
# Bounded dimensions used by the target-tracking policy and dashboard.
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=
